# Copy to /opt/sub2api-staging/.env during staging initialization.
# The initialization script generates all secret values. Do not use production
# values in this file.
SUB2API_IMAGE=ghcr.io/qxsazz/model-gate-sub2api@sha256:replace-me
STAGING_PORT=8081
BIND_HOST=127.0.0.1
SERVER_PORT=8081
SERVER_MODE=release
RUN_MODE=standard
POSTGRES_USER=sub2api_staging
POSTGRES_DB=sub2api_staging
POSTGRES_PASSWORD=replace-me
REDIS_PASSWORD=replace-me
ADMIN_EMAIL=staging-admin@model-gate.cc
ADMIN_PASSWORD=replace-me
JWT_SECRET=replace-me
TOTP_ENCRYPTION_KEY=replace-me
TZ=Asia/Shanghai
SECURITY_URL_ALLOWLIST_ENABLED=true
SECURITY_URL_ALLOWLIST_ALLOW_INSECURE_HTTP=false
SECURITY_URL_ALLOWLIST_ALLOW_PRIVATE_HOSTS=false
